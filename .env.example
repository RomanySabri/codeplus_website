# ---------------------------------------------------------------------------
# CodePlus Software House - Environment Variables Example
# ---------------------------------------------------------------------------

# Public URL of the website
NEXT_PUBLIC_SITE_URL=https://codeplusdev.com

# Google Analytics tracking ID
NEXT_PUBLIC_GA_ID=

# Contact form receiving email (for backend routing, if applicable)
NEXT_PUBLIC_CONTACT_EMAIL=hello@codeplusdev.com


# Email configuration for sending emails (e.g., onboarding, notifications)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_REPLY_TO=
EMAIL_NAME=
EMAIL_USER=
EMAIL_PASS=